# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files (may contain sensitive data)
terraform.tfvars
*.auto.tfvars

# Terraform lock file (optional - some teams commit this)
# .terraform.lock.hcl

# Terraform directory
.terraform/

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan
tfplan.json

# Sensitive variable files
*.secret
*.secrets
